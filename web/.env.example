# Copy to .env.local for local development. Never commit real values.
# Every variable the web app reads is documented here. Vite exposes only
# VITE_-prefixed variables to the bundle, so nothing here may be a secret.

# Backend API origin (no trailing slash, no path). Also stamped into the
# CSP connect-src in dist/_headers at build time.
VITE_API_URL=http://localhost:8080

# The app has no identity-provider configuration. Sign-in and sign-up
# post directly to the API's /v1/auth/* endpoints; the callback, refresh,
# and sign-out also go through the API, which holds the provider
# credentials.
