# Public URL of this site. Canonical origin in <head> and the sitemap base.
PUBLIC_SITE_URL=http://localhost:4321
# Origin of the web app that the sign-in and sign-up links point at.
PUBLIC_APP_ORIGIN=http://localhost:5173
# Base URL for the public four-question configurator. The site posts JSON to
# /download and /email beneath this URL.
PUBLIC_TEMPLATE_DELIVERY_URL=http://localhost:8080/v1/public/sow-configurator
# Keep false until a real provider-backed email send is verified end-to-end.
PUBLIC_CONFIGURATOR_EMAIL_ENABLED=false
