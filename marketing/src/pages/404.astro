---
import Base from '@/layouts/Base.astro'
---

<Base title="Page not found" description="There is nothing at this address." noindex>
  <section class="mx-auto max-w-2xl px-6 py-24 text-center">
    <h1 class="text-display">Page not found</h1>
    <p class="mt-6">There is nothing at this address.</p>
    <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/" class="btn-hero btn-hero-primary">Back to the front page</a>
      <button type="button" data-open-template class="btn-hero btn-hero-secondary"
        >Download template</button
      >
    </div>
  </section>
</Base>
