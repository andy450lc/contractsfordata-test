---
const year = new Date().getFullYear()
---

<footer class="border-t border-line">
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-5 px-6 py-8 text-xs tracking-[0.4px] text-muted"
  >
    <p>&copy; {year} SoW</p>
    <button type="button" data-open-template class="link text-xs"
      >Download template</button
    >
  </div>
</footer>
