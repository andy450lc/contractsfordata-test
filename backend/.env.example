# Copy to .env for local development (STAGE != prod loads it automatically).
# Never commit .env. Every variable the app reads is documented here.

# dev | staging | prod
STAGE=dev

# HTTP listen port
PORT=8080

# Postgres DSN. Required. The app refuses to start without it.
# Single-quote the value. Double quotes expand $ as a variable.
# Percent-encode special characters in the password (%25 for %, %23 for #).
DATABASE_URL='postgres://sow:sow@localhost:5432/sow?sslmode=disable'

# Database pool
DB_POOL_MAX_CONNS=10
DB_POOL_MIN_CONNS=2

# Comma-separated origin allowlist for CORS. The session endpoints also
# check the Origin header against this list.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4321,http://127.0.0.1:4321

# Global per-IP rate limit (requests/second and burst)
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# Stricter per-IP rate limit for the /v1/auth group
AUTH_RATE_LIMIT_RPS=2
AUTH_RATE_LIMIT_BURST=10

# Public acknowledged Word delivery endpoints. These conservative per-IP
# limits are applied in addition to the global limiter.
TEMPLATE_DELIVERY_RATE_LIMIT_RPS=1
TEMPLATE_DELIVERY_RATE_LIMIT_BURST=5

# Graceful shutdown grace period (seconds)
SHUTDOWN_GRACE_SECONDS=10

# WorkOS AuthKit. The API is the OAuth client, so it holds the secrets.
# The first four are required. The app refuses to start without them.
# API key (secret, sk_...) — WorkOS dashboard → API Keys
WORKOS_API_KEY=
# Client id (client_...) — WorkOS dashboard → the AuthKit application
WORKOS_CLIENT_ID=
# Webhook signing secret — WorkOS dashboard → Webhooks endpoint for user
# events (user.created / user.updated / user.deleted)
WORKOS_WEBHOOK_SECRET=
# Redirect URI registered with WorkOS. It points at this API, not the SPA.
WORKOS_REDIRECT_URI=http://localhost:8080/v1/auth/callback
# Optional JWKS endpoint override. Empty derives
# https://api.workos.com/sso/jwks/<client id>. Set only in tests or
# unusual network setups.
WORKOS_JWKS_URL=
# Optional WorkOS API base URL override. Empty uses the SDK default.
# Tests point it at a fake provider.
WORKOS_BASE_URL=

# HTTP timeout for WorkOS API calls, in seconds. A stale connection or
# an unresponsive provider fails within this many seconds instead of
# hanging the request.
WORKOS_TIMEOUT_SECONDS=15

# Origin of the web app. The callback redirects here after sign-in.
WEB_APP_URL=http://localhost:5173

# Session cookie encryption keys. Required. Comma-separated
# kid:base64(32 bytes) entries. The first entry seals new cookies and
# every entry opens existing ones, so rotation adds a new first entry
# and drops the old one later.
# Generate an entry with: echo "k1:$(openssl rand -base64 32)"
SESSION_COOKIE_KEY=

# Session cookie lifetime in seconds (default seven days)
SESSION_MAX_AGE_SECONDS=604800

# Transactional email. Required in staging and prod. When either value is
# absent locally, email delivery reports that it is unavailable; it never
# presents a simulated send as successful. Direct Word download still works.
# Resend API key (secret, re_...) — Resend dashboard → API Keys
RESEND_API_KEY=
# Verified Resend sender used for platform mail and Word attachments
EMAIL_FROM=

# Sentry — required in prod, empty locally (Sentry only runs in deployed stages)
SENTRY_DSN=

# OpenTelemetry OTLP endpoint; empty disables the exporter (spans still
# generate ids for log correlation)
OTEL_EXPORTER_OTLP_ENDPOINT=
